# ── AWS Credentials (NEVER hardcode; use IAM roles or Secrets Manager in production) ──
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=ap-south-1
S3_BUCKET_NAME=airline-nlp-models

# ── RDS / PostgreSQL ────────────────────────────────────────────────────────────
DB_HOST=your-rds-endpoint.amazonaws.com
DB_PORT=5432
DB_NAME=airline_logs
DB_USER=admin
DB_PASSWORD=your_secure_password_here

# ── Application Settings ──────────────────────────────────────────────────────
STREAMLIT_PORT=8501
LOG_LEVEL=INFO

# ── Model Settings ─────────────────────────────────────────────────────────────
SEVERITY_MODEL_NAME=distilbert-base-uncased
RANDOM_SEED=42
